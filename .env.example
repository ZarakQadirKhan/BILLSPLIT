# Atlas Free only. Store real values in .env.local or Vercel environment settings.
# Never use a VITE_ prefix or commit a connection string containing a password.
MONGODB_URI=
MONGODB_DB=tab_together

# Dedicated FREE Gmail sender. Google 2-Step Verification + App Password required.
# Never use your normal Google account password here.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Production website origin, e.g. https://your-project.vercel.app (no trailing slash).
APP_BASE_URL=

# Optional Gemini receipt extraction. Use a FREE-tier project with billing disabled.
# Server-only key: never prefix with VITE_. Missing key automatically uses local OCR.
GEMINI_API_KEY=
# App-wide attempts/day (UTC), not a claim about Google's quota. 0 disables Gemini.
GEMINI_DAILY_LIMIT=20

# Optional PAID OpenAI scanning, first before Gemini/OCR. Server-only.
OPENAI_API_KEY=
# Cumulative app-wide USD budget, NOT monthly. Default/maximum $5; 0 disables.
# Shared persistent MongoDB reservations include uncertain/failed requests.
OPENAI_BUDGET_USD=5
